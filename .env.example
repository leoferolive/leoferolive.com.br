# URL base da chat-api (FastAPI). Em dev local: http://localhost:8000
VITE_CHAT_API_URL=http://localhost:8000

# Cloudflare Turnstile site key.
# Em dev local: o valor abaixo é a "always passes" test key pública da
# Cloudflare. Em prod, o build é parametrizado pela GitHub variable
# VITE_TURNSTILE_SITE_KEY (real key gerada no painel Cloudflare).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
