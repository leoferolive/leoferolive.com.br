# URL base da chat-api (FastAPI). Em dev local: http://localhost:8000
VITE_CHAT_API_URL=http://localhost:8000

# Cloudflare Turnstile site key. O valor abaixo é a "always passes" test key
# pública da Cloudflare e deve ser substituída pela real em prod.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
